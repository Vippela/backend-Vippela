# Copie para um arquivo .env (não versione) ou exporte no terminal.
# No PowerShell:  $env:SUPABASE_DB_URL = "..."
# No cmd:         setx SUPABASE_DB_URL "..."

# --- Banco no Supabase (PostgreSQL) -------------------------------------
# Conexão direta (exige IPv6 ou o add-on IPv4 do projeto):
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Alternativa para rede só IPv4 (Supavisor, modo sessão):
# SUPABASE_DB_URL=jdbc:postgresql://postgres.<project-ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# O plano free do Supabase aceita poucas conexões: pool pequeno.
DB_POOL_SIZE=5
PORT=8080

# --- Cadastro e login ----------------------------------------------------
VIPPELA_AUTH_TTL_HOURS=720
VIPPELA_AUTH_MAX_TENTATIVAS=10
VIPPELA_AUTH_JANELA_MINUTOS=15

# --- Login com Google ----------------------------------------------------
# Caminho do JSON de service account do Firebase. Sem este valor,
# POST /auth/google responde 503 e o e-mail/senha segue normal.
VIPPELA_GOOGLE_CREDENTIALS=

# --- Postgres local (alternativa ao Supabase, já usada no projeto) ------
# VIPPELA_DB_URL=jdbc:postgresql://localhost:5432/vippela_db
# VIPPELA_DB_USER=postgres
# VIPPELA_DB_PASSWORD=
