# Lido pelo Spring Boot como arquivo .properties. Não use export nem aspas.
# Preencha com a conexão PostgreSQL do Supabase (não com a URL da API REST).
VIPPELA_DB_URL=
VIPPELA_DB_USER=
VIPPELA_DB_PASSWORD=

# Caminho absoluto do JSON de conta de serviço; nunca cole a chave privada aqui.
VIPPELA_GOOGLE_CREDENTIALS=
PORT=8080
